{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "flask",
  "buildCommand": "python build_vercel.py",
  "functions": {
    "main.py": {
      "maxDuration": 300,
      "excludeFiles": "{.venv/**,tests/**,playground/**,instance/**,public/**,main/static/**,*.mp4,**/__pycache__/**,**/*.pyc}"
    }
  }
}
